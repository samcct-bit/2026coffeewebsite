rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoffeeAdmin() {
      return request.auth != null
        && request.auth.uid == 'coffee-site-admin'
        && request.auth.token.coffeeAdmin == true
        && request.auth.token.coffeeSessionExpiresAt is int
        && request.auth.token.auth_time is int
        && request.auth.token.coffeeSessionExpiresAt <= request.auth.token.auth_time + 3600
        && request.time >= timestamp.value(request.auth.token.auth_time * 1000)
        && request.time < timestamp.value(request.auth.token.coffeeSessionExpiresAt * 1000);
    }
    function validRoast() {
      return request.resource.data.keys().hasAll(['beanName', 'roastDate'])
        && request.resource.data.keys().size() <= 100
        && request.resource.data.beanName is string
        && request.resource.data.beanName.size() > 0
        && request.resource.data.beanName.size() <= 240
        && request.resource.data.roastDate is string
        && request.resource.data.roastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validDraft() {
      return request.resource.data.payload is map
        && request.resource.data.payload.keys().size() <= 100
        && request.resource.data.payload.beanName is string
        && request.resource.data.payload.beanName.size() > 0
        && request.resource.data.payload.beanName.size() <= 240
        && request.resource.data.payload.roastDate is string
        && request.resource.data.payload.roastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.draftVersion is string
        && request.resource.data.draftVersion.size() >= 16
        && request.resource.data.basePublishedRevision is int
        && request.resource.data.basePublishedRevision >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validPublication(document, previousRevision) {
      let candidate = request.resource.data;
      let before = get(/databases/$(database)/documents/coffee_roast_drafts/$(document)).data;
      let after = getAfter(/databases/$(database)/documents/coffee_roast_drafts/$(document)).data;
      return candidate.keys().hasOnly([
        'id', 'beanName', 'nameEn', 'origin', 'machine', 'roastDate', 'process', 'altitude', 'variety', 'cropYear',
        'roastLevel', 'chargeMassG', 'dropMassG', 'chargeTemp', 'tpTemp', 'tpTime', 'fcTemp', 'fcTime',
        'dropTemp', 'dropTime', 'dtrRatio', 'lossRatio', 'flavorTop', 'flavorMid', 'flavorBase', 'storyCopy',
        'brewTemp', 'brewMethod', 'brewAiTip', 'brewGuideNote', 'cuppingScore', 'rorDatapointsJson',
        'timelineActionsJson', 'rorQualityScore', 'imageUrl', 'image', 'beanImage', 'dashboardUrl',
        'aiAnalyzedAt', 'aiAnalysisVersion', 'sensoryProfile',
        'publicationRevision', 'publishedAt', 'publishedBy', 'sourceDraftVersion', 'publicationReview'
      ])
        && candidate.publicationRevision is int
        && candidate.publicationRevision == previousRevision + 1
        && candidate.publishedAt == request.time
        && candidate.publishedBy == request.auth.uid
        && candidate.id == document
        && candidate.publicationReview.identityConfirmed == true
        && candidate.publicationReview.flavorReviewed == true
        && candidate.publicationReview.evidenceLimitationsAccepted == true
        && candidate.publicationReview.keys().hasOnly([
          'identityConfirmed', 'flavorReviewed', 'evidenceLimitationsAccepted', 'sensoryBasis', 'cuppingDate'
        ])
        && candidate.publicationReview.sensoryBasis in ['reference', 'cupped']
        && (candidate.publicationReview.sensoryBasis != 'cupped' || validCuppingEvidence(document, before.payload, candidate))
        && (!candidate.keys().hasAny(['sensoryProfile']) || candidate.publicationReview.sensoryBasis == 'cupped')
        && (candidate.publicationReview.sensoryBasis != 'cupped'
          || candidate.publicationReview.cuppingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && candidate.flavorTop is string && candidate.flavorTop.size() > 0 && candidate.flavorTop.size() <= 13
        && candidate.flavorMid is string && candidate.flavorMid.size() > 0 && candidate.flavorMid.size() <= 13
        && candidate.flavorBase is string && candidate.flavorBase.size() > 0 && candidate.flavorBase.size() <= 13
        && before.status == 'draft'
        && before.draftVersion == candidate.sourceDraftVersion
        && before.basePublishedRevision == previousRevision
        && candidate.beanName == before.payload.beanName
        && candidate.roastDate == before.payload.roastDate
        && candidate.flavorTop == before.payload.flavorTop
        && candidate.flavorMid == before.payload.flavorMid
        && candidate.flavorBase == before.payload.flavorBase
        && candidate.get('storyCopy', '') == before.payload.get('storyCopy', '')
        && (candidate.publicationReview.sensoryBasis == 'cupped' || candidate.get('cuppingScore', 0) == 0)
        && after.status == 'published'
        && after.lastPublishedVersion == candidate.sourceDraftVersion
        && after.basePublishedRevision == candidate.publicationRevision
        && after.review == candidate.publicationReview;
    }
    function cuppingRound(r, locked) {
      // The service validates complete round semantics before locking/adopting. Keep rule evaluation bounded.
      return r.flavor is string && r.mouthfeel is string && r.aftertaste is string;
    }
    function cuppingCup(c, locked) {
      return c.keys().hasOnly(['concern', 'rounds']) && c.concern is string && c.concern.size() <= 500
        && c.rounds is list && c.rounds.size() == 3
        && cuppingRound(c.rounds[0], locked) && cuppingRound(c.rounds[1], locked) && cuppingRound(c.rounds[2], locked);
    }
    function validCuppingSession(batch) {
      let s = request.resource.data;
      let f = s.form;
      let locked = s.status == 'locked';
      return s.keys().hasOnly(['batchId', 'form', 'method', 'roastColor', 'roastFingerprint', 'roastSnapshot', 'referenceSnapshot',
          'status', 'version', 'createdAt', 'updatedAt', 'updatedBy', 'lockedAt'])
        && s.batchId == batch && s.method == 'solo' && s.roastColor == 'unmeasured'
        && s.status in ['draft', 'locked'] && s.version is string && s.version.size() >= 16
        && s.roastFingerprint is string && s.roastFingerprint.size() == 64 && s.roastSnapshot is map && s.referenceSnapshot is map
        && s.updatedAt == request.time && s.updatedBy == request.auth.uid
        && (locked ? s.lockedAt == request.time : s.lockedAt == null)
        && f.keys().hasOnly(['date', 'greenLot', 'grinder', 'grindSetting', 'waterSource', 'doseG', 'vesselMl', 'waterTempC', 'referenceHidden', 'conditionsConfirmed', 'qualityNote', 'cups'])
        && f.date is string && f.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && f.greenLot is string && f.greenLot.size() <= 500 && (!locked || f.greenLot.size() > 0)
        && f.grinder is string && f.grinder.size() <= 500 && (!locked || f.grinder.size() > 0)
        && f.grindSetting is string && f.grindSetting.size() <= 500 && (!locked || f.grindSetting.size() > 0)
        && f.waterSource is string && f.waterSource.size() <= 500 && (!locked || f.waterSource.size() > 0)
        && f.qualityNote is string && f.qualityNote.size() <= 500
        && f.doseG is number && f.doseG >= 1 && f.doseG <= 100
        && f.vesselMl is number && f.vesselMl >= 50 && f.vesselMl <= 1000
        && f.waterTempC is number && f.waterTempC >= 1 && f.waterTempC <= 100
        && f.referenceHidden is bool && f.conditionsConfirmed is bool && (!locked || f.conditionsConfirmed)
        && f.cups is list && f.cups.size() == 3
        && cuppingCup(f.cups[0], locked) && cuppingCup(f.cups[1], locked) && cuppingCup(f.cups[2], locked);
    }
    function sameRoast(s, p) {
      return s.batchId == p.id
        && s.roastSnapshot.beanName == p.beanName && s.roastSnapshot.roastDate == p.roastDate
        && s.roastSnapshot.machine == p.get('machine', null)
        && s.roastSnapshot.origin == p.get('origin', null) && s.roastSnapshot.process == p.get('process', null)
        && s.roastSnapshot.variety == p.get('variety', null) && s.roastSnapshot.greenLotId == p.get('greenLotId', null)
        && s.roastSnapshot.chargeMassG == p.get('chargeMassG', null) && s.roastSnapshot.dropMassG == p.get('dropMassG', null)
        && s.roastSnapshot.chargeTemp == p.get('chargeTemp', null)
        && s.roastSnapshot.fcTime == p.get('fcTime', null) && s.roastSnapshot.dropTime == p.get('dropTime', null)
        && s.roastSnapshot.rorDatapointsJson == p.get('rorDatapointsJson', '[]');
    }
    function validCuppingEvidence(batch, payload, candidate) {
      let ids = payload.cuppingSessionIds;
      let profile = candidate.sensoryProfile;
      let first = get(/databases/$(database)/documents/coffee_roast_drafts/$(batch)/cupping_sessions/$(ids[0])).data;
      let second = get(/databases/$(database)/documents/coffee_roast_drafts/$(batch)/cupping_sessions/$(ids[ids.size() - 1])).data;
      return ids is list && ids.size() >= 1 && ids.size() <= 2
        && first.status == 'locked' && second.status == 'locked' && sameRoast(first, payload)
        && second.roastSnapshot == first.roastSnapshot && second.roastFingerprint == first.roastFingerprint
        && profile == payload.sensoryProfile
        && profile.keys().hasOnly(['method', 'status', 'dates', 'flavor', 'mouthfeel', 'aftertaste'])
        && profile.method == 'solo' && profile.status == (ids.size() == 2 ? 'repeated' : 'single')
        && profile.dates is list && profile.dates.size() == ids.size()
        && profile.dates.hasAll([first.form.date, second.form.date])
        && candidate.publicationReview.cuppingDate in profile.dates
        && candidate.publicationReview.cuppingDate >= first.form.date && candidate.publicationReview.cuppingDate >= second.form.date
        && profile.flavor == candidate.flavorTop && profile.mouthfeel == candidate.flavorMid && profile.aftertaste == candidate.flavorBase
        && candidate.get('cuppingScore', 0) == 0
        && (ids.size() == 1 || (ids[0] != ids[1] && first.form.date != second.form.date
          && first.form.greenLot == second.form.greenLot && first.form.waterSource == second.form.waterSource
          && first.form.grinder == second.form.grinder && first.form.grindSetting == second.form.grindSetting
          && first.form.doseG == second.form.doseG && first.form.vesselMl == second.form.vesselMl));
    }
    match /coffee_roasts/{document} {
      // 任何人都可以讀取（公開豆單）
      allow read: if true;
      allow create: if isCoffeeAdmin() && validRoast() && validPublication(document, 0);
      allow update: if isCoffeeAdmin() && validRoast()
        && validPublication(document, resource.data.get('publicationRevision', 0));
      allow delete: if isCoffeeAdmin();
    }
    match /coffee_roast_drafts/{document} {
      allow read, delete: if isCoffeeAdmin();
      allow create, update: if isCoffeeAdmin() && validDraft();
    }
    match /coffee_roast_drafts/{batch}/cupping_sessions/{session} {
      allow read: if isCoffeeAdmin();
      allow create: if isCoffeeAdmin() && validCuppingSession(batch) && request.resource.data.createdAt == request.time;
      allow update: if isCoffeeAdmin() && resource.data.status == 'draft' && validCuppingSession(batch)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.roastFingerprint == resource.data.roastFingerprint
        && request.resource.data.roastSnapshot == resource.data.roastSnapshot
        && request.resource.data.referenceSnapshot == resource.data.referenceSnapshot
        && request.resource.data.version != resource.data.version;
      allow delete: if isCoffeeAdmin() && resource.data.status == 'draft';
    }
    match /coffee_publication_history/{document}/versions/{version} {
      allow read: if isCoffeeAdmin();
      allow create: if isCoffeeAdmin()
        && request.resource.data.record is map
        && request.resource.data.publicationRevision is int
        && request.resource.data.record == get(/databases/$(database)/documents/coffee_roasts/$(document)).data
        && request.resource.data.publicationRevision == get(/databases/$(database)/documents/coffee_roasts/$(document)).data.get('publicationRevision', 0)
        && request.resource.data.archivedAt == request.time
        && request.resource.data.archivedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // 保留 2026-10-17 讀取到的既有教學專案權限，不影響其他網站。
    match /summer_homework_2026/{document} {
      allow read: if request.auth != null
        && request.auth.token.email == 'samcct@gmail.com';
      allow create, update, delete: if false;
    }
  }
}
